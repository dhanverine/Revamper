{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revamper",
  "version": "0.1.1",
  "identifier": "dev.revamper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "title": "Revamper overlay",
        "width": 450,
        "height": 450,
        "x": -10000,
        "y": -10000,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Dhanraj Babar",
    "copyright": "Copyright (c) 2026 Dhanraj Babar",
    "shortDescription": "Hold Shift, drag a file, drop it on a slice to convert, compress, crop, trim, merge or extract it.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../vendor/ffmpeg/bin": "ffmpeg/bin",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}